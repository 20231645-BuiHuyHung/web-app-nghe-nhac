# Cấu hình môi trường cho Music App
# Sao chép file này thành .env và điền giá trị thực khi triển khai

# Cổng server (mặc định: 3000)
PORT=3000

# Mật mã JWT (bắt buộc, thay đổi bằng chuỗi ngẫu nhiên dài)
JWT_SECRET=your-super-secret-jwt-key-change-me-in-production

# Thời gian hiệu lực session (mặc định: 7 ngày)
SESSION_TTL=604800000

# Cấu hình SMTP cho email đặt lại mật khẩu (bỏ trống nếu không dùng email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_FROM=
SMTP_USER=
SMTP_PASS=

# URL cơ sở của ứng dụng (dùng để tạo link đặt lại mật khẩu và URL callback VNPay)
# Để bật VNPay, đổi thành URL HTTPS công khai có thể nhận Return redirect.
APP_BASE_URL=http://localhost:3000

# VNPay Sandbox (để trống/tắt nếu chưa đăng ký tài khoản Merchant Sandbox)
# TMN_CODE là mã website do VNPay cấp; HASH_SECRET dùng ký/xác minh chữ ký, tuyệt đối không chia sẻ.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Có thể chỉ định đường dẫn callback riêng; cả hai URL cũng phải là HTTPS công khai:
# VNPAY_RETURN_URL=https://your-public-domain.example/api/payments/vnpay/return
# VNPAY_IPN_URL=https://your-public-domain.example/api/payments/vnpay/ipn

# Môi trường: development | production
NODE_ENV=development